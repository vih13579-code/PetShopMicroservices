@model IReadOnlyCollection<InventoryVm>
@{ ViewData["Title"] = "Quản lý tồn kho"; var total=Model.Sum(x=>x.Quantity); var reserved=Model.Sum(x=>x.ReservedQuantity); var available=Model.Sum(x=>x.AvailableQuantity); }
<div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4"><div><div class="page-kicker">PB35 · Inventory Service</div><h1 class="page-title">Quản lý tồn kho</h1><p class="page-subtitle">Theo dõi lượng hàng có thể bán, hàng đang giữ khi checkout và cập nhật tồn kho thực tế.</p></div><button class="btn btn-brand" data-bs-toggle="collapse" data-bs-target="#stockForm">+ Cập nhật số lượng</button></div>
@if(ViewBag.Error!=null){<div class="alert alert-danger">@ViewBag.Error</div>}
<div class="row g-3 mb-4"><div class="col-md-4"><div class="surface stat-card d-flex justify-content-between"><div><div class="stat-label">Tổng trong kho</div><div class="stat-value">@total</div></div><div class="stat-icon">Σ</div></div></div><div class="col-md-4"><div class="surface stat-card d-flex justify-content-between"><div><div class="stat-label">Đang giữ</div><div class="stat-value">@reserved</div></div><div class="stat-icon">⌛</div></div></div><div class="col-md-4"><div class="surface stat-card d-flex justify-content-between"><div><div class="stat-label">Có thể bán</div><div class="stat-value">@available</div></div><div class="stat-icon">✓</div></div></div></div>
<div class="collapse mb-4" id="stockForm"><form asp-action="Set" method="post" class="surface p-4"><h5 class="fw-bold mb-3">Điều chỉnh tồn kho</h5><div class="row g-3"><div class="col-md-4"><label class="form-label">Mã sản phẩm</label><input name="productId" class="form-control" required placeholder="Nhập Product ID"/></div><div class="col-md-3"><label class="form-label">Số lượng mới</label><input name="quantity" type="number" min="0" class="form-control" required/></div><div class="col-md-3"><label class="form-label">Lý do</label><input name="reason" class="form-control" placeholder="Nhập hàng, kiểm kê..."/></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-brand w-100">Lưu thay đổi</button></div></div></form></div>
<div class="surface table-card">@if(!Model.Any()){<div class="empty-state"><div class="empty-icon">▦</div><h5>Chưa có dữ liệu tồn kho</h5><p>Cập nhật số lượng cho sản phẩm đầu tiên của shop.</p></div>}else{<table class="table"><thead><tr><th>Sản phẩm</th><th>Tổng số lượng</th><th>Đang giữ</th><th>Có thể bán</th><th>Mức tồn</th><th>Cập nhật</th></tr></thead><tbody>@foreach(var i in Model){var percent=i.Quantity==0?0:(int)Math.Round(i.AvailableQuantity*100d/i.Quantity);<tr><td><span class="order-code">@i.ProductId.ToString()[..8]</span><div class="small text-muted">@i.ProductId</div></td><td class="money">@i.Quantity</td><td><span class="status-pill status-warning">@i.ReservedQuantity</span></td><td><span class="status-pill @(i.AvailableQuantity>0?"status-success":"status-danger")">@i.AvailableQuantity</span></td><td style="min-width:130px"><div class="progress-track"><span style="width:@percent%"></span></div><small class="text-muted">@percent%</small></td><td class="small text-muted">@i.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td></tr>}</tbody></table>}</div>
