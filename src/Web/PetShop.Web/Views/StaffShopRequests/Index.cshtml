@model IReadOnlyCollection<ShopRequestVm>
@{
    ViewData["Title"] = "Duyệt yêu cầu mở Shop";
    var currentStatus = ViewBag.Status as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-dark mb-0">
        <i class="bi bi-file-earmark-check text-success me-2"></i>Quản lý Yêu cầu Mở Shop (Staff)
    </h2>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Tìm theo tên Shop, chủ Shop, email..." />
                </div>
            </div>
            <div class="col-md-4">
                <select name="status" class="form-select">
                    <option value="">-- Tất cả Trạng thái --</option>
                    <option value="Pending" selected="@(currentStatus == "Pending")">Chờ duyệt (Pending)</option>
                    <option value="Approved" selected="@(currentStatus == "Approved")">Đã duyệt (Approved)</option>
                    <option value="Rejected" selected="@(currentStatus == "Rejected")">Đã từ chối (Rejected)</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-success w-100 fw-semibold">
                    <i class="bi bi-filter me-1"></i>Tìm & Lọc
                </button>
            </div>
        </form>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger shadow-sm mb-4">@ViewBag.Error</div>
}

@if (TempData["Success"] is string successMsg)
{
    <div class="alert alert-success shadow-sm mb-4">
        <i class="bi bi-check-circle me-1"></i>@successMsg
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Tên Shop & Địa chỉ</th>
                        <th>Chủ sở hữu</th>
                        <th>Thông tin liên hệ</th>
                        <th>Trạng thái</th>
                        <th>Ngày gửi</th>
                        <th class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Không tìm thấy yêu cầu mở Shop nào.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var x in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-bold text-dark">@x.ShopName</div>
                                    <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>@x.Address</small>
                                </td>
                                <td><span class="fw-semibold">@x.OwnerName</span></td>
                                <td>
                                    <div><i class="bi bi-envelope me-1"></i>@x.Email</div>
                                    <small class="text-muted"><i class="bi bi-telephone me-1"></i>@x.Phone</small>
                                </td>
                                <td>
                                    <span class="badge @(x.Status == "Pending" ? "bg-warning text-dark" : x.Status == "Approved" ? "bg-success" : "bg-danger")">
                                        @x.Status
                                    </span>
                                </td>
                                <td class="small text-muted">@x.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end pe-3">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-outline-info" title="Xem chi tiết">
                                            <i class="bi bi-eye"></i> Chi tiết
                                        </a>

                                        @if (x.Status == "Pending")
                                        {
                                            <form asp-action="Approve" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@x.Id" />
                                                <button class="btn btn-sm btn-success" title="Duyệt mở Shop">
                                                    <i class="bi bi-check-lg"></i> Duyệt
                                                </button>
                                            </form>
                                            <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal-@x.Id" title="Từ chối">
                                                <i class="bi bi-x-lg"></i> Từ chối
                                            </button>

                                            <!-- Modal Từ Chối -->
                                            <div class="modal fade text-start" id="rejectModal-@x.Id" tabindex="-1">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <form asp-action="Reject" method="post">
                                                            <div class="modal-header">
                                                                <h5 class="modal-title fw-bold">Từ chối yêu cầu mở Shop</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <input type="hidden" name="id" value="@x.Id" />
                                                                <p class="mb-2">Bạn đang từ chối yêu cầu mở Shop <strong>@x.ShopName</strong> của <strong>@x.OwnerName</strong>.</p>
                                                                <label class="form-label fw-semibold">Lý do từ chối:</label>
                                                                <textarea name="reason" class="form-control" rows="3" required placeholder="Nhập lý do từ chối cụ thể..."></textarea>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                                <button type="submit" class="btn btn-danger">Xác nhận Từ Chối</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
