@model IReadOnlyCollection<NotificationVm>
@{ViewData["Title"]="Thông báo";var unread=Model.Count(x=>!x.IsRead);}
<div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4"><div><div class="page-kicker">PB60 · PB61</div><h1 class="page-title">Trung tâm thông báo</h1><p class="page-subtitle">Cập nhật mới nhất về đăng ký shop, đơn hàng và thanh toán của bạn.</p></div><span class="status-pill @(unread>0?"status-warning":"status-success")">@unread chưa đọc</span></div>
@if(ViewBag.Error!=null){<div class="alert alert-danger">@ViewBag.Error</div>}
<div class="d-grid gap-3">@if(!Model.Any()){<div class="surface empty-state"><div class="empty-icon">✓</div><h5>Bạn đã xem hết thông báo</h5><p>Thông báo mới sẽ xuất hiện tại đây.</p></div>}@foreach(var n in Model){<article class="surface notification-card @(!n.IsRead?"unread":"")"><div class="notification-dot">@(n.Type.Contains("Payment",StringComparison.OrdinalIgnoreCase)?"₫":n.Type.Contains("Order",StringComparison.OrdinalIgnoreCase)?"□":"i")</div><div class="flex-grow-1"><div class="d-flex justify-content-between gap-3"><h5 class="fw-bold mb-1">@n.Title</h5><small class="text-muted text-nowrap">@n.CreatedAt.ToLocalTime().ToString("dd/MM · HH:mm")</small></div><p class="text-secondary mb-2">@n.Message</p><div class="d-flex align-items-center gap-2"><span class="status-pill">@n.Type</span>@if(!n.IsRead){<form asp-action="Read" method="post"><input type="hidden" name="id" value="@n.Id"/><button class="btn btn-sm btn-outline-primary">Đánh dấu đã đọc</button></form>}</div></div></article>}</div>
