@model ProfileFormVm
@{
    ViewData["Title"] = "Thông tin cá nhân";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-dark mb-0">
        <i class="bi bi-person-bounding-box text-primary me-2"></i>Hồ sơ cá nhân
    </h2>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Quay lại Dashboard
    </a>
</div>

@if (TempData["Success"] is string successMsg)
{
    <div class="alert alert-success shadow-sm mb-4">
        <i class="bi bi-check-circle me-1"></i>@successMsg
    </div>
}

@if (ViewBag.Error is string errMsg)
{
    <div class="alert alert-danger shadow-sm mb-4">
        <i class="bi bi-exclamation-triangle me-1"></i>@errMsg
    </div>
}

<div class="row g-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body text-center p-4">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex p-4 mb-3">
                    <i class="bi bi-person-fill fs-1"></i>
                </div>
                <h4 class="fw-bold mb-1">@Model.FullName</h4>
                <p class="text-muted small mb-3">@Model.Email</p>
                <div class="d-flex flex-wrap justify-content-center gap-1 mb-3">
                    @foreach (var r in Model.Roles)
                    {
                        <span class="badge bg-primary bg-gradient">@r</span>
                    }
                </div>
                <hr />
                <div class="text-start small text-muted">
                    <div class="mb-2"><i class="bi bi-calendar3 me-2"></i>Ngày tạo: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                    <div class="mb-2"><i class="bi bi-telephone me-2"></i>SĐT: @(string.IsNullOrWhiteSpace(Model.Phone) ? "Chưa cập nhật" : Model.Phone)</div>
                    <div><i class="bi bi-geo-alt me-2"></i>Địa chỉ: @(string.IsNullOrWhiteSpace(Model.Address) ? "Chưa cập nhật" : Model.Address)</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-pencil-square me-2 text-warning"></i>Cập nhật thông tin</h5>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Địa chỉ Email</label>
                        <input value="@Model.Email" class="form-control bg-light" disabled />
                        <div class="form-text">Email không thể thay đổi.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold">Họ và tên</label>
                        <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên..." />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label fw-semibold">Số điện thoại</label>
                        <input asp-for="Phone" class="form-control" placeholder="Nhập số điện thoại..." />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Address" class="form-label fw-semibold">Địa chỉ giao hàng / Liên hệ</label>
                        <textarea asp-for="Address" class="form-control" rows="3" placeholder="Nhập địa chỉ..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-warning fw-bold px-4 text-dark">
                        <i class="bi bi-save me-1"></i>Lưu thay đổi
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
