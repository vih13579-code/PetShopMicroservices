@model ShopEditVm
@{
    ViewData["Title"] = "Shop của tôi";
}

<div class="page-header">
    <div>
        <span class="page-kicker">KÊNH CHỦ SHOP</span>
        <h1 class="page-heading">Thông tin Shop của tôi</h1>
        <p class="page-subtitle">Cập nhật thông tin hiển thị và dữ liệu liên hệ của cửa hàng.</p>
    </div>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Dashboard
    </a>
</div>

@if (Model == null)
{
    <div class="empty-state text-center">
        <i class="bi bi-shop-window"></i>
        <h4>Không tìm thấy thông tin Shop</h4>
        <p class="mb-4">@ViewBag.Error</p>
        <a asp-controller="ShopRegistration" asp-action="Index" class="btn btn-warning">Kiểm tra yêu cầu mở shop</a>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header d-flex align-items-center gap-3">
                    <div class="icon-tile"><i class="bi bi-shop"></i></div>
                    <div>
                        <h5 class="mb-1">Hồ sơ cửa hàng</h5>
                        <p class="small text-muted mb-0">Thông tin này được dùng trong quá trình vận hành và liên hệ.</p>
                    </div>
                </div>
                <div class="card-body p-4">
                    <form method="post" novalidate>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="OwnerUserId" />
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Name" class="form-label">Tên cửa hàng</label>
                                <input asp-for="Name" class="form-control" placeholder="Nhập tên cửa hàng" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Description" class="form-label">Mô tả</label>
                                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Giới thiệu về cửa hàng"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label">Điện thoại</label>
                                <input asp-for="Phone" class="form-control" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label">Email</label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Address" class="form-label">Địa chỉ</label>
                                <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="TaxCode" class="form-label">Mã số thuế</label>
                                <input asp-for="TaxCode" class="form-control" />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-warning px-4 mt-4">
                            <i class="bi bi-check2-circle me-1"></i>Lưu thay đổi
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="soft-panel">
                <div class="icon-tile mb-3"><i class="bi bi-lightbulb"></i></div>
                <h5>Mẹo hoàn thiện Shop</h5>
                <p class="text-muted mb-0">Tên và mô tả rõ ràng giúp khách hàng nhận biết cửa hàng nhanh hơn. Hãy đảm bảo số điện thoại và email luôn chính xác.</p>
            </div>
        </div>
    </div>
}
