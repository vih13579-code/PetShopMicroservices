@model ProductDetailsVm
@{var p=Model.Product;ViewData["Title"]=p.Name;var avg=Model.Reviews.Any()?Model.Reviews.Average(x=>x.Rating):0;}
<a asp-action="Index" class="text-decoration-none text-secondary">← Tiếp tục mua sắm</a><div class="row g-5 mt-1 mb-5"><div class="col-lg-6"><div class="product-visual">@if(!string.IsNullOrWhiteSpace(p.ImageUrl)){<img src="@p.ImageUrl" alt="@p.Name"/>}else{<div class="product-placeholder">P</div>}</div></div><div class="col-lg-6"><div class="page-kicker">@p.CategoryName</div><h1 class="page-title">@p.Name</h1><div class="d-flex align-items-center gap-2 mb-3"><span class="review-stars">★★★★★</span><span class="text-muted">@avg.ToString("0.0") · @Model.Reviews.Count đánh giá</span></div><p class="fs-3 money text-success">@p.Price.ToString("N0") ₫</p><p class="text-secondary">@p.Description</p><form asp-controller="Cart" asp-action="Add" method="post" class="surface p-4 mt-4"><input type="hidden" name="productId" value="@p.Id"/><div class="row g-3"><div class="col-sm-8"><label class="form-label">Phân loại</label><select name="variantId" class="form-select"><option value="">Mặc định</option>@foreach(var v in p.Variants.Where(x=>x.IsActive)){<option value="@v.Id">@v.Name (+@v.AdditionalPrice.ToString("N0") ₫)</option>}</select></div><div class="col-sm-4"><label class="form-label">Số lượng</label><input type="number" name="quantity" min="1" value="1" class="form-control"/></div><div class="col-12"><button class="btn btn-brand w-100">Thêm vào giỏ hàng</button></div></div></form></div></div>
<section><div class="d-flex justify-content-between align-items-end mb-3"><div><div class="page-kicker">PB63 · Đánh giá</div><h2 class="fw-bold mb-0">Khách hàng nói gì</h2></div></div><div class="row g-4"><div class="col-lg-5"><form asp-action="Review" method="post" class="surface p-4"><input type="hidden" name="ProductId" value="@p.Id"/><h5 class="fw-bold">Viết đánh giá</h5><p class="small text-muted">Chỉ tài khoản đã mua và hoàn thành đơn mới có thể gửi.</p><label class="form-label">Mức hài lòng</label><select name="Rating" class="form-select mb-3"><option value="5">5 sao · Rất hài lòng</option><option value="4">4 sao · Hài lòng</option><option value="3">3 sao · Bình thường</option><option value="2">2 sao · Chưa tốt</option><option value="1">1 sao · Không hài lòng</option></select><label class="form-label">Nhận xét</label><textarea name="Comment" rows="4" maxlength="2000" class="form-control mb-3" placeholder="Chia sẻ trải nghiệm của bạn..."></textarea><button class="btn btn-brand">Gửi đánh giá</button></form></div><div class="col-lg-7"><div class="d-grid gap-3">@if(!Model.Reviews.Any()){<div class="surface empty-state"><div class="empty-icon">☆</div><h5>Chưa có đánh giá</h5><p>Hãy là người đầu tiên chia sẻ trải nghiệm.</p></div>}@foreach(var r in Model.Reviews){<article class="surface p-4"><div class="d-flex justify-content-between"><div class="review-stars">@(new string('★',r.Rating))@(new string('☆',5-r.Rating))</div><small class="text-muted">@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</small></div><p class="mt-2 mb-1">@(string.IsNullOrWhiteSpace(r.Comment)?"Khách hàng không để lại nhận xét.":r.Comment)</p><small class="text-muted">Khách hàng @r.UserId.ToString()[..8]</small></article>}</div><div class="danger-zone mt-3"><div class="small text-muted mb-2">Bạn đã đánh giá? Có thể gửi lại bằng “Cập nhật” hoặc xóa đánh giá của mình.</div><div class="d-flex gap-2"><form asp-action="UpdateReview" method="post" class="d-flex gap-2 flex-grow-1"><input type="hidden" name="ProductId" value="@p.Id"/><input type="hidden" name="Rating" value="5"/><input name="Comment" class="form-control form-control-sm" placeholder="Nội dung cập nhật"/><button class="btn btn-sm btn-outline-primary">Cập nhật</button></form><form asp-action="DeleteReview" method="post"><input type="hidden" name="productId" value="@p.Id"/><button class="btn btn-sm btn-outline-danger">Xóa</button></form></div></div></div></div></section>
