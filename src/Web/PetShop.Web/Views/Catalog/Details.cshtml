@model ProductDetailsPageVm
@{ ViewData["Title"] = Model.Product.Name; var p=Model.Product; }
<a class="btn btn-light mb-3" asp-action="Index"><i data-lucide="arrow-left"></i>Quay lại catalog</a>
<div class="detail-layout mb-5"><div class="surface detail-media">@if(!string.IsNullOrWhiteSpace(p.ImageUrl)){<img src="@p.ImageUrl" alt="@p.Name"/>}else{<div class="empty"><i data-lucide="image"></i></div>}</div><section><span class="eyebrow">@p.CategoryName</span><h1 class="mt-2 mb-3">@p.Name</h1><p class="text-secondary">@(p.Description ?? "Sản phẩm chưa có mô tả.")</p><div class="price fs-3 my-4">@p.Price.ToString("N0") đ</div><form asp-controller="Cart" asp-action="Add" method="post" class="surface panel"><input type="hidden" name="productId" value="@p.Id"/><div class="mb-3"><label class="form-label">Phân loại</label><select name="variantId" class="form-select"> <option value="">Mặc định</option>@foreach(var v in p.Variants){<option value="@v.Id">@v.Name (+@v.AdditionalPrice.ToString("N0") đ)</option>}</select></div><div class="mb-3"><label class="form-label">Số lượng</label><input type="number" name="quantity" min="1" max="99" value="1" required class="form-control"/></div><button class="btn btn-primary w-100"><i data-lucide="shopping-bag"></i>Thêm vào giỏ</button></form></section></div>
<section><div class="page-head"><div><h2>Đánh giá sản phẩm</h2><p>@Model.Reviews.Count đánh giá từ khách đã mua hàng.</p></div></div><div class="row g-4"><div class="col-lg-7"><div class="surface px-4">@foreach(var review in Model.Reviews){<article class="review"><div class="rating">@for(var i=0;i<review.Rating;i++){<i data-lucide="star"></i>}</div><p class="my-2">@(review.Comment ?? "Không có nội dung.")</p><small class="text-secondary">@review.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></article>}@if(!Model.Reviews.Any()){<div class="empty"><i data-lucide="message-square"></i><div>Chưa có đánh giá nào.</div></div>}</div></div><div class="col-lg-5"><form asp-action="CreateReview" method="post" class="surface panel" novalidate><input type="hidden" name="productId" value="@p.Id"/><h3 class="h5">Chia sẻ trải nghiệm</h3><p class="small text-secondary">Chỉ khách đã hoàn thành đơn hàng mới có thể đánh giá.</p><div class="mb-3"><label class="form-label">Số sao</label><select asp-for="ReviewForm.Rating" name="Rating" class="form-select" required><option value="5">5 - Tuyệt vời</option><option value="4">4 - Tốt</option><option value="3">3 - Bình thường</option><option value="2">2 - Chưa tốt</option><option value="1">1 - Rất tệ</option></select></div><div class="mb-3"><label class="form-label">Nội dung</label><textarea asp-for="ReviewForm.Comment" name="Comment" class="form-control" rows="5" maxlength="2000"></textarea></div><button class="btn btn-primary w-100"><i data-lucide="send"></i>Gửi đánh giá</button></form></div></div></section>
