@model CatalogPageVm
@{ ViewData["Title"] = "Khám phá sản phẩm"; }
<div class="page-head"><div><span class="eyebrow">Marketplace</span><h1>Chọn điều tốt nhất cho thú cưng</h1><p>Sản phẩm từ các Shop đã được duyệt trên toàn hệ thống.</p></div><div class="text-secondary small">@Model.Result.TotalItems kết quả</div></div>
<form method="get" id="catalogFilter" class="surface toolbar" novalidate><div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div><div class="row g-2"><div class="col-lg-4"><label class="form-label">Từ khóa</label><input name="keyword" value="@Model.Keyword" class="form-control" maxlength="220" placeholder="Tên hoặc mô tả sản phẩm"/></div><div class="col-lg-2"><label class="form-label">Shop</label><select name="shopId" class="form-select"><option value="">Tất cả Shop</option>@foreach(var shop in Model.Shops){<option value="@shop.Id" selected="@(Model.ShopId==shop.Id)">@shop.Name</option>}</select></div><div class="col-lg-2"><label class="form-label">Danh mục</label><select name="categoryId" class="form-select"><option value="">Tất cả danh mục</option>@foreach(var c in Model.Categories.Where(x=>!Model.ShopId.HasValue||x.ShopId==Model.ShopId)){<option value="@c.Id" selected="@(Model.CategoryId==c.Id)">@c.Name</option>}</select></div><div class="col-6 col-lg-1"><label class="form-label">Giá từ</label><input name="minPrice" value="@Model.MinPrice" type="number" min="0" max="1000000000" class="form-control"/></div><div class="col-6 col-lg-1"><label class="form-label">Đến</label><input name="maxPrice" value="@Model.MaxPrice" type="number" min="0" max="1000000000" class="form-control"/></div><div class="col-lg-2 d-flex align-items-end"><button class="btn btn-primary w-100"><i data-lucide="sliders-horizontal"></i>Áp dụng</button></div></div><div id="priceError" class="text-danger mt-2"></div></form>
@if(ViewBag.Error is string error){<div class="alert alert-danger"><i data-lucide="circle-alert"></i>@error</div>}
<div class="product-grid">@foreach(var p in Model.Result.Items){<article class="surface product-card"><a asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none text-dark"><div class="product-media">@if(!string.IsNullOrWhiteSpace(p.ImageUrl)){<img src="@p.ImageUrl" alt="@p.Name" loading="lazy"/>}else{<i data-lucide="image"></i>}</div><div class="product-body"><div class="product-meta">@p.CategoryName</div><h2 class="product-name">@p.Name</h2><div class="d-flex justify-content-between align-items-center"><span class="price">@p.Price.ToString("N0") đ</span><span class="small text-secondary">@p.Variants.Count phân loại</span></div></div></a></article>}</div>
@if(!Model.Result.Items.Any()){<div class="surface empty"><i data-lucide="search-x"></i><h2 class="h5">Chưa tìm thấy sản phẩm</h2><p>Thử thay đổi từ khóa hoặc khoảng giá.</p></div>}
@if(Model.Result.TotalPages>1){<nav class="mt-4"><ul class="pagination justify-content-center">@for(var i=1;i<=Model.Result.TotalPages;i++){<li class="page-item @(i==Model.Result.Page?"active":"")"><a class="page-link" asp-route-page="@i" asp-route-keyword="@Model.Keyword" asp-route-shopId="@Model.ShopId" asp-route-categoryId="@Model.CategoryId" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice">@i</a></li>}</ul></nav>}
@section Scripts { <script>document.querySelector('#catalogFilter').addEventListener('submit',e=>{const min=Number(e.currentTarget.minPrice.value||0),max=Number(e.currentTarget.maxPrice.value||0),box=document.querySelector('#priceError');box.textContent=max&&min>max?'Giá thấp nhất không được lớn hơn giá cao nhất.':'';if(box.textContent)e.preventDefault();});</script> }
