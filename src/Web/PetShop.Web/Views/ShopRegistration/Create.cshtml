@model ShopRequestFormVm
@{
    ViewData["Title"] = "Đăng ký Shop";
}

<div class="page-header">
    <div>
        <span class="page-kicker">TRỞ THÀNH ĐỐI TÁC</span>
        <h1 class="page-heading">Đăng ký mở Shop</h1>
        <p class="page-subtitle">Cung cấp thông tin kinh doanh để đội ngũ PET Shop kiểm tra và phê duyệt hồ sơ.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Lịch sử yêu cầu
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex align-items-center gap-3">
                <div class="icon-tile"><i class="bi bi-building-add"></i></div>
                <div>
                    <h5 class="mb-1">Thông tin cửa hàng</h5>
                    <p class="small text-muted mb-0">Vui lòng nhập thông tin chính xác để rút ngắn thời gian xét duyệt.</p>
                </div>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="ShopName" class="form-label">Tên cửa hàng</label>
                            <input asp-for="ShopName" class="form-control" placeholder="Ví dụ: Happy Paws Store" />
                            <span asp-validation-for="ShopName" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label">Mô tả</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Giới thiệu ngắn về cửa hàng, sản phẩm và thế mạnh..."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label">Số điện thoại</label>
                            <input asp-for="Phone" class="form-control" placeholder="09xxxxxxxx" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email liên hệ</label>
                            <input asp-for="Email" class="form-control" placeholder="shop@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Address" class="form-label">Địa chỉ cửa hàng</label>
                            <textarea asp-for="Address" class="form-control" rows="3" minlength="5" maxlength="500" required placeholder="Nhập địa chỉ đầy đủ"></textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TaxCode" class="form-label">Mã số thuế</label>
                            <input asp-for="TaxCode" class="form-control" placeholder="Không bắt buộc" />
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button type="submit" class="btn btn-warning px-4">
                            <i class="bi bi-send-check me-1"></i>Gửi yêu cầu
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="soft-panel mb-3">
            <div class="icon-tile mb-3"><i class="bi bi-clipboard-check"></i></div>
            <h5>Quy trình xét duyệt</h5>
            <ol class="text-muted ps-3 mb-0">
                <li class="mb-2">Gửi đầy đủ thông tin cửa hàng.</li>
                <li class="mb-2">Staff kiểm tra hồ sơ.</li>
                <li>Nhận kết quả phê duyệt hoặc lý do từ chối.</li>
            </ol>
        </div>
        <div class="checkout-note">
            <i class="bi bi-info-circle text-primary fs-5"></i>
            <small>Bạn có thể theo dõi trạng thái hồ sơ tại trang “Yêu cầu mở Shop”.</small>
        </div>
    </div>
</div>
