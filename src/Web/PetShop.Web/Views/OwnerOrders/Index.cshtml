@model IReadOnlyCollection<OrderVm>
@{
    ViewData["Title"] = "Quản lý Đơn hàng Shop";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-dark mb-0">
        <i class="bi bi-receipt-cutoff text-primary me-2"></i>Quản lý Đơn hàng Cửa hàng (Shop)
    </h2>
</div>

@if (TempData["Success"] is string successMsg)
{
    <div class="alert alert-success shadow-sm mb-4"><i class="bi bi-check-circle me-1"></i>@successMsg</div>
}
@if (TempData["Error"] is string errorMsg)
{
    <div class="alert alert-danger shadow-sm mb-4"><i class="bi bi-exclamation-triangle me-1"></i>@errorMsg</div>
}
@if (ViewBag.Error is string err)
{
    <div class="alert alert-danger shadow-sm mb-4">@err</div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Mã đơn hàng</th>
                        <th>Khách nhận</th>
                        <th>Tổng tiền</th>
                        <th>Thanh toán</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Chưa có đơn hàng nào tại Cửa hàng.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var o in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-bold text-primary">#@o.OrderCode</div>
                                    <small class="text-muted"><code>@o.Id.ToString()[..8]</code></small>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@o.ReceiverName</div>
                                    <small class="text-muted"><i class="bi bi-telephone me-1"></i>@o.ReceiverPhone</small>
                                </td>
                                <td class="fw-bold text-danger">@o.TotalAmount.ToString("N0") VNĐ</td>
                                <td>
                                    <span class="badge @(o.PaymentStatus == "Paid" ? "bg-success" : "bg-warning text-dark")">
                                        @o.PaymentMethod (@o.PaymentStatus)
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(o.Status == "Completed" ? "bg-success" : o.Status == "Cancelled" ? "bg-danger" : "bg-info text-dark")">
                                        @o.Status
                                    </span>
                                </td>
                                <td class="small text-muted">@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end pe-3">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-info" title="Xem chi tiết">
                                            <i class="bi bi-eye"></i> Chi tiết
                                        </a>

                                        @if (o.Status == "Pending")
                                        {
                                            <form asp-action="Confirm" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@o.Id" />
                                                <button class="btn btn-sm btn-success" title="Xác nhận đơn">Xác nhận</button>
                                            </form>
                                        }
                                        @if (o.Status == "Confirmed")
                                        {
                                            <form asp-action="Preparing" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@o.Id" />
                                                <button class="btn btn-sm btn-primary" title="Chuẩn bị hàng">Chuẩn bị</button>
                                            </form>
                                        }
                                        @if (o.Status == "Preparing")
                                        {
                                            <form asp-action="Shipping" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@o.Id" />
                                                <button class="btn btn-sm btn-primary" title="Bắt đầu giao">Giao hàng</button>
                                            </form>
                                        }
                                        @if (o.Status == "Shipping")
                                        {
                                            <form asp-action="Complete" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@o.Id" />
                                                <button class="btn btn-sm btn-success" title="Hoàn thành đơn">Hoàn thành</button>
                                            </form>
                                        }
                                        @if (o.PaymentMethod == "COD" && o.PaymentStatus == "CodPending" && o.Status != "Cancelled")
                                        {
                                            <form asp-action="ConfirmCodPayment" method="post" class="d-inline">
                                                <input type="hidden" name="orderId" value="@o.Id" />
                                                <button class="btn btn-sm btn-warning fw-semibold text-dark" title="Xác nhận tiền mặt COD">
                                                    <i class="bi bi-cash"></i> Nhận COD
                                                </button>
                                            </form>
                                        }
                                        @if (o.Status == "Pending" || o.Status == "Confirmed" || o.Status == "Preparing")
                                        {
                                            <form asp-action="Cancel" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@o.Id" />
                                                <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Hủy đơn hàng này?');" title="Hủy đơn">Hủy</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
