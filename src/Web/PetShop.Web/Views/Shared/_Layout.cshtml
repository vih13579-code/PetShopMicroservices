@inject GatewayApiClient ApiClient
@{
    var user = ApiClient.CurrentUser;
    var isLoggedIn = ApiClient.IsLoggedIn;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PetShop System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold text-primary fs-4" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark"><i class="bi bi-heart-fill"></i></span><span>PET Shop</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Catalog" asp-action="Index"><i class="bi bi-grid me-1"></i>Sản phẩm</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Shops" asp-action="Index"><i class="bi bi-houses me-1"></i>Cửa hàng</a>
                        </li>

                        @if (isLoggedIn && user != null)
                        {
                            @if (user.IsCustomer || (!user.IsAdmin && !user.IsStaff && !user.IsShopOwner))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Cart" asp-action="Index"><i class="bi bi-cart me-1"></i>Giỏ hàng</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Orders" asp-action="Index"><i class="bi bi-bag-check me-1"></i>Đơn hàng</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="ShopRegistration" asp-action="Index"><i class="bi bi-shop-window me-1"></i>Mở Shop</a>
                                </li>
                            }

                            @if (user.IsShopOwner && !user.IsAdmin && !user.IsStaff)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle fw-semibold text-warning" href="#" id="shopOwnerDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-building-gear me-1"></i>Kênh Chủ Shop
                                    </a>
                                    <ul class="dropdown-menu shadow" aria-labelledby="shopOwnerDropdown">
                                        <li><a class="dropdown-item" asp-controller="Shops" asp-action="Mine"><i class="bi bi-info-circle me-2"></i>Thông tin Shop</a></li>
                                        <li><a class="dropdown-item" asp-controller="OwnerCatalog" asp-action="Categories"><i class="bi bi-tags me-2"></i>Quản lý Danh mục</a></li>
                                        <li><a class="dropdown-item" asp-controller="OwnerCatalog" asp-action="Products"><i class="bi bi-box-seam me-2"></i>Quản lý Sản phẩm</a></li>
                                        <li><a class="dropdown-item" asp-controller="Inventory" asp-action="Index"><i class="bi bi-boxes me-2"></i>Quản lý Tồn kho</a></li>
                                        <li><a class="dropdown-item" asp-controller="OwnerOrders" asp-action="Index"><i class="bi bi-receipt me-2"></i>Xử lý Đơn hàng</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-warning fw-semibold" asp-controller="Reports" asp-action="Shop"><i class="bi bi-graph-up-arrow me-2"></i>Báo cáo Doanh thu Shop</a></li>
                                    </ul>
                                </li>
                            }

                            @if (user.IsStaff && !user.IsAdmin)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle fw-semibold text-info" href="#" id="staffDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-person-badge me-1"></i>Kênh Staff
                                    </a>
                                    <ul class="dropdown-menu shadow" aria-labelledby="staffDropdown">
                                        <li><a class="dropdown-item" asp-controller="StaffShopRequests" asp-action="Index"><i class="bi bi-file-earmark-check me-2"></i>Duyệt Yêu cầu mở Shop</a></li>
                                        <li><a class="dropdown-item" asp-controller="Shops" asp-action="Manage"><i class="bi bi-sliders me-2"></i>Quản lý Shop</a></li>
                                    </ul>
                                </li>
                            }

                            @if (user.IsAdmin)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle fw-semibold text-danger" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-shield-lock me-1"></i>Quản trị Admin
                                    </a>
                                    <ul class="dropdown-menu shadow" aria-labelledby="adminDropdown">
                                        <li><a class="dropdown-item" asp-controller="AdminAccounts" asp-action="Index"><i class="bi bi-people me-2"></i>Quản lý Tài khoản (Staff/Users)</a></li>
                                        <li><a class="dropdown-item" asp-controller="Shops" asp-action="Manage"><i class="bi bi-shop me-2"></i>Quản lý Khóa/Mở Shop</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger fw-semibold" asp-controller="Reports" asp-action="Admin"><i class="bi bi-pie-chart me-2"></i>Báo cáo Doanh thu Hệ thống</a></li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
                        @if (isLoggedIn && user != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link position-relative" asp-controller="Notifications" asp-action="Index" title="Thông báo">
                                    <i class="bi bi-bell fs-5"></i>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link fw-semibold" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-1" href="#" id="userMenuDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5"></i>
                                    <span>@user.FullName</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userMenuDropdown">
                                    <li class="dropdown-header">
                                        <div class="fw-bold">@user.FullName</div>
                                        <small class="text-muted">@user.Email</small>
                                        <div class="mt-1">
                                            @foreach (var r in user.Roles)
                                            {
                                                <span class="badge bg-secondary me-1">@r</span>
                                            }
                                        </div>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Profile" asp-action="Index">
                                            <i class="bi bi-person-bounding-box me-2"></i>Thông tin cá nhân
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm px-3 me-2" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm px-3" asp-controller="Account" asp-action="Register">Đăng ký</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="app-shell flex-grow-1">
        @if (isLoggedIn && user != null && !Context.Request.Path.StartsWithSegments("/Home"))
        {
            <aside class="app-sidebar shadow-sm">
                <div class="sidebar-title"><i class="bi bi-grid-1x2-fill me-2"></i>Không gian làm việc</div>
                <a asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i>Tổng quan</a>
                <a asp-controller="Catalog" asp-action="Index"><i class="bi bi-box-seam"></i>Sản phẩm</a>
                @if (user.IsAdmin)
                {
                    <div class="sidebar-label">ADMIN</div>
                    <a asp-controller="AdminAccounts" asp-action="Index"><i class="bi bi-people"></i>Tài khoản</a>
                    <a asp-controller="Shops" asp-action="Manage"><i class="bi bi-shop"></i>Quản lý cửa hàng</a>
                    <a asp-controller="Reports" asp-action="Admin"><i class="bi bi-bar-chart"></i>Báo cáo hệ thống</a>
                }
                else if (user.IsStaff)
                {
                    <div class="sidebar-label">STAFF</div>
                    <a asp-controller="StaffShopRequests" asp-action="Index"><i class="bi bi-check2-square"></i>Duyệt mở shop</a>
                    <a asp-controller="Shops" asp-action="Manage"><i class="bi bi-shop"></i>Quản lý shop</a>
                }
                else if (user.IsShopOwner)
                {
                    <div class="sidebar-label">SHOP OWNER</div>
                    <a asp-controller="Shops" asp-action="Mine"><i class="bi bi-building"></i>Shop của tôi</a>
                    <a asp-controller="OwnerCatalog" asp-action="Products"><i class="bi bi-box-seam"></i>Sản phẩm</a>
                    <a asp-controller="Inventory" asp-action="Index"><i class="bi bi-boxes"></i>Tồn kho</a>
                    <a asp-controller="OwnerOrders" asp-action="Index"><i class="bi bi-receipt"></i>Đơn hàng</a>
                    <a asp-controller="Reports" asp-action="Shop"><i class="bi bi-graph-up"></i>Doanh thu</a>
                }
                else
                {
                    <div class="sidebar-label">CUSTOMER</div>
                    <a asp-controller="Cart" asp-action="Index"><i class="bi bi-cart"></i>Giỏ hàng</a>
                    <a asp-controller="Orders" asp-action="Index"><i class="bi bi-bag-check"></i>Đơn hàng</a>
                    <a asp-controller="ShopRegistration" asp-action="Index"><i class="bi bi-shop-window"></i>Mở shop</a>
                }
            </aside>
        }
        <main class="container app-main flex-grow-1">
        @if (TempData["Success"] is string s)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@s
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] is string e)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@e
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
        </main>
    </div>

    <footer class="site-footer mt-auto">
        <div class="footer-main">
            <div class="container">
                <div class="row g-4">
                    <div class="col-lg-4 col-md-6">
                        <a class="footer-brand d-inline-flex align-items-center gap-2 mb-3" asp-controller="Home" asp-action="Index">
                            <span class="brand-mark"><i class="bi bi-heart-fill"></i></span>
                            <span>PET Shop</span>
                        </a>
                        <p class="mb-4 pe-lg-5">Hệ sinh thái mua sắm và quản lý cửa hàng dành cho thú cưng, kết nối khách hàng với những shop uy tín.</p>
                        <div class="footer-social">
                            <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                            <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                            <a href="#" aria-label="Youtube"><i class="bi bi-youtube"></i></a>
                            <a href="#" aria-label="Tiktok"><i class="bi bi-tiktok"></i></a>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <h6 class="footer-heading">Khám phá</h6>
                        <div class="footer-links">
                            <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                            <a asp-controller="Catalog" asp-action="Index">Sản phẩm</a>
                            <a asp-controller="Shops" asp-action="Index">Cửa hàng</a>
                            <a asp-controller="ShopRegistration" asp-action="Index">Mở shop</a>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <h6 class="footer-heading">Tài khoản</h6>
                        <div class="footer-links">
                            @if (isLoggedIn)
                            {
                                <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                                <a asp-controller="Profile" asp-action="Index">Hồ sơ cá nhân</a>
                                <a asp-controller="Notifications" asp-action="Index">Thông báo</a>
                                <a asp-controller="Account" asp-action="Logout">Đăng xuất</a>
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Login">Đăng nhập</a>
                                <a asp-controller="Account" asp-action="Register">Đăng ký</a>
                            }
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <h6 class="footer-heading">Liên hệ hỗ trợ</h6>
                        <div class="footer-contact"><i class="bi bi-geo-alt-fill"></i><span>Cần Thơ, Việt Nam</span></div>
                        <div class="footer-contact"><i class="bi bi-envelope-fill"></i><span>support@petshop.local</span></div>
                        <div class="footer-contact"><i class="bi bi-telephone-fill"></i><span>1900 0000</span></div>
                        <div class="footer-contact"><i class="bi bi-clock-fill"></i><span>Thứ 2 - Chủ nhật: 08:00 - 21:00</span></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
                <span>&copy; 2026 PET Shop Microservices. All rights reserved.</span>
                <span>Made with <i class="bi bi-heart-fill text-warning mx-1"></i> for every pet.</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
