@inject PetShop.Web.Services.GatewayApiClient SessionApi
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - PawMart</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg sticky-top app-nav">
    <div class="container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark"><i data-lucide="paw-print"></i></span>PawMart</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button>
        <div id="mainNav" class="collapse navbar-collapse">
            <div class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                <a class="nav-link" asp-controller="Catalog" asp-action="Index"><i data-lucide="store"></i>Khám phá</a>
                @if (SessionApi.IsInRole("ShopOwner")) { <a class="nav-link" asp-controller="OwnerCatalog" asp-action="Products"><i data-lucide="package"></i>Quản lý Shop</a> }
                @if (SessionApi.IsInRole("Customer") || SessionApi.IsInRole("ShopOwner")) {
                    <a class="nav-link" asp-controller="Cart" asp-action="Index"><i data-lucide="shopping-bag"></i>Giỏ hàng</a>
                    <a class="nav-link" asp-controller="Orders" asp-action="Index"><i data-lucide="receipt-text"></i>Đơn hàng</a>
                }
                @if (SessionApi.IsLoggedIn) {
                    <a class="nav-link" asp-controller="Dashboard" asp-action="Index"><i data-lucide="layout-dashboard"></i>Dashboard</a>
                    <a class="nav-link" asp-controller="Notifications" asp-action="Index" title="Thông báo"><i data-lucide="bell"></i><span class="d-lg-none">Thông báo</span></a>
                    <a class="btn btn-nav" asp-controller="Account" asp-action="Logout">Đăng xuất</a>
                } else { <a class="btn btn-nav" asp-controller="Account" asp-action="Login">Đăng nhập</a> }
            </div>
        </div>
    </div>
</nav>
<main class="container app-main">
    @if (TempData["Success"] is string success) { <div class="alert alert-success alert-dismissible fade show"><i data-lucide="circle-check"></i>@success<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger alert-dismissible fade show"><i data-lucide="circle-alert"></i>@error<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
    @RenderBody()
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js"></script>
<script>lucide.createIcons();</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
