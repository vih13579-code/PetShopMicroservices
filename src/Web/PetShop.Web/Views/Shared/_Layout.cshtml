<!DOCTYPE html>
<html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>@ViewData["Title"] - PawMart</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"/><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head>
<body><header class="app-header"><nav class="navbar navbar-expand-xl"><div class="container"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">P</span><span>PawMart<small>pet marketplace</small></span></a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="mainNav"><div class="navbar-nav ms-auto align-items-xl-center gap-xl-1"><a class="nav-link" asp-controller="Catalog" asp-action="Index">Sản phẩm</a><a class="nav-link" asp-controller="Cart" asp-action="Index">Giỏ hàng</a><a class="nav-link" asp-controller="Orders" asp-action="Index">Đơn mua</a><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Quản lý</a><a class="nav-link" asp-controller="Notifications" asp-action="Index">Thông báo</a><a class="nav-link login-link" asp-controller="Account" asp-action="Login">Đăng nhập</a><a class="btn btn-brand btn-sm ms-xl-2" asp-controller="Account" asp-action="Logout">Đăng xuất</a></div></div></div></nav></header>
<main class="container app-main">@if(TempData["Success"] is string s){<div class="alert alert-success app-alert">@s</div>}@if(TempData["Error"] is string e){<div class="alert alert-danger app-alert">@e</div>}@RenderBody()</main><footer><div class="container d-flex justify-content-between flex-wrap gap-2"><span>© @DateTime.Now.Year PawMart</span><span>Mua sắm an tâm · Chăm pet trọn vẹn</span></div></footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
