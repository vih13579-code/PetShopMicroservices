@{
    ViewData["Title"] = "Đã xảy ra lỗi";
}

<section class="auth-page">
    <div class="content-card text-center" style="max-width: 650px;">
        <div class="mx-auto mb-3" style="font-size: 5rem;">🐾</div>
        <span class="page-kicker">PET SHOP SYSTEM</span>
        <h1 class="page-heading mb-3">Đã xảy ra lỗi</h1>
        <p class="text-muted mb-4">Hệ thống chưa thể xử lý yêu cầu của bạn. Vui lòng quay lại trang trước hoặc thử lại sau.</p>
        <div class="d-flex flex-wrap justify-content-center gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-warning">
                <i class="bi bi-house-door me-1"></i>Về trang chủ
            </a>
            <button type="button" class="btn btn-outline-secondary" onclick="history.back()">
                <i class="bi bi-arrow-left me-1"></i>Quay lại
            </button>
        </div>
    </div>
</section>
