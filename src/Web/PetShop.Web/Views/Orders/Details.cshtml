@model OrderVm
@{ViewData["Title"]="Chi tiết đơn hàng";var statusClass=Model.Status=="Completed"?"status-success":Model.Status=="Cancelled"?"status-danger":"status-warning";}
<a asp-action="Index" class="text-decoration-none text-secondary">← Quay lại đơn hàng</a><div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mt-3 mb-4"><div><div class="page-kicker">Chi tiết đơn hàng</div><h1 class="page-title">@Model.OrderCode</h1><p class="page-subtitle">Đặt lúc @Model.CreatedAt.ToLocalTime().ToString("HH:mm, dd/MM/yyyy")</p></div><span class="status-pill @statusClass">@Model.Status</span></div>
<div class="row g-4"><div class="col-lg-8"><div class="surface table-card"><div class="p-4 border-bottom"><h5 class="fw-bold mb-0">Sản phẩm</h5></div><table class="table"><tbody>@foreach(var i in Model.Items){<tr><td><div class="fw-bold">@i.ProductName</div><small class="text-muted">@(i.VariantName??"Mặc định")</small></td><td>x @i.Quantity</td><td class="money text-end">@i.LineTotal.ToString("N0") ₫</td></tr>}</tbody></table><div class="p-4"><div class="d-flex justify-content-between text-secondary mb-2"><span>Tạm tính</span><span>@Model.SubTotal.ToString("N0") ₫</span></div><div class="d-flex justify-content-between text-secondary mb-3"><span>Phí giao hàng</span><span>@Model.ShippingFee.ToString("N0") ₫</span></div><div class="d-flex justify-content-between fs-4 fw-bold border-top pt-3"><span>Tổng cộng</span><span class="text-success">@Model.TotalAmount.ToString("N0") ₫</span></div></div></div></div><div class="col-lg-4"><div class="surface p-4 mb-3"><h5 class="fw-bold">Thông tin nhận hàng</h5><p class="mb-1 fw-bold">@Model.ReceiverName</p><p class="text-secondary mb-1">@Model.ReceiverPhone</p><p class="text-secondary mb-0">@Model.ShippingAddress</p>@if(!string.IsNullOrWhiteSpace(Model.Note)){<hr/><small class="text-muted">Ghi chú: @Model.Note</small>}</div><div class="surface p-4"><h5 class="fw-bold">Thanh toán</h5><div class="d-flex justify-content-between mb-3"><span>@Model.PaymentMethod</span><span class="status-pill">@Model.PaymentStatus</span></div>@if(Model.PaymentStatus is "Pending" or "CodPending"){<div class="d-grid gap-2"><form asp-controller="Payments" asp-action="Create" method="post"><input type="hidden" name="orderId" value="@Model.Id"/><input type="hidden" name="method" value="COD"/><button class="btn btn-outline-secondary w-100">Thanh toán COD</button></form><form asp-controller="Payments" asp-action="Create" method="post"><input type="hidden" name="orderId" value="@Model.Id"/><input type="hidden" name="method" value="BankTransferMock"/><button class="btn btn-brand w-100">Chuyển khoản mô phỏng</button></form></div>}</div></div></div>
