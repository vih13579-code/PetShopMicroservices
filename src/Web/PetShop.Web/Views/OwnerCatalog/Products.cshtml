@model OwnerProductsPageVm
@{ ViewData["Title"] = "Sản phẩm Shop"; }
<div class="page-head"><div><span class="eyebrow">Catalog Studio</span><h1>Sản phẩm của Shop</h1><p>@Model.Result.TotalItems sản phẩm trong catalog.</p></div><a class="btn btn-primary" asp-action="ProductForm"><i data-lucide="plus"></i>Tạo sản phẩm</a></div>
<nav class="owner-tabs"><a asp-action="Categories">Danh mục</a><a class="active" asp-action="Products">Sản phẩm</a></nav>
<form method="get" class="surface toolbar"><div class="row g-2"><div class="col-lg-5"><input name="keyword" value="@Model.Keyword" class="form-control" placeholder="Tìm theo tên sản phẩm" /></div><div class="col-lg-3"><select name="categoryId" class="form-select"><option value="">Tất cả danh mục</option>@foreach(var c in Model.Categories){<option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>}</select></div><div class="col-lg-2"><select name="isActive" class="form-select"><option value="">Mọi trạng thái</option><option value="true" selected="@(Model.IsActive == true)">Đang bán</option><option value="false" selected="@(Model.IsActive == false)">Ngừng bán</option></select></div><div class="col-lg-2"><button class="btn btn-primary w-100"><i data-lucide="search"></i>Lọc</button></div></div></form>
@if(ViewBag.Error is string error){<div class="alert alert-danger">@error</div>}
<div class="surface table-responsive"><table class="table"><thead><tr><th>Sản phẩm</th><th>Danh mục</th><th>Giá</th><th>Phân loại</th><th>Trạng thái</th><th></th></tr></thead><tbody>
@foreach(var p in Model.Result.Items){<tr><td><div class="d-flex align-items-center gap-2">@if(!string.IsNullOrWhiteSpace(p.ImageUrl)){<img src="@p.ImageUrl" alt="" width="48" height="48" class="rounded object-fit-cover"/>}<a asp-action="ProductDetails" asp-route-id="@p.Id" class="fw-semibold text-dark text-decoration-none">@p.Name</a></div></td><td>@p.CategoryName</td><td><strong>@p.Price.ToString("N0") đ</strong></td><td>@p.Variants.Count</td><td><span class="status @(p.IsActive ? "status-on" : "status-off")">@(p.IsActive ? "Đang bán" : "Ngừng bán")</span></td><td><div class="action-row"><a class="btn btn-light icon-btn" asp-action="ProductDetails" asp-route-id="@p.Id" title="Xem chi tiết"><i data-lucide="eye"></i></a><a class="btn btn-light icon-btn" asp-action="ProductForm" asp-route-id="@p.Id" title="Chỉnh sửa"><i data-lucide="pencil"></i></a>@if(p.IsActive){<form asp-action="DeleteProduct" method="post" onsubmit="return confirm('Ngừng bán sản phẩm này?');"><input type="hidden" name="id" value="@p.Id"/><button class="btn btn-light icon-btn text-danger" title="Ngừng bán"><i data-lucide="circle-stop"></i></button></form>}</div></td></tr>}
@if(!Model.Result.Items.Any()){<tr><td colspan="6"><div class="empty"><i data-lucide="package-open"></i><div>Không tìm thấy sản phẩm phù hợp.</div></div></td></tr>}
</tbody></table></div>
@if(Model.Result.TotalPages > 1){<nav class="mt-3"><ul class="pagination justify-content-center">@for(var i=1;i<=Model.Result.TotalPages;i++){<li class="page-item @(i==Model.Result.Page?"active":"")"><a class="page-link" asp-route-page="@i" asp-route-keyword="@Model.Keyword" asp-route-categoryId="@Model.CategoryId" asp-route-isActive="@Model.IsActive">@i</a></li>}</ul></nav>}
