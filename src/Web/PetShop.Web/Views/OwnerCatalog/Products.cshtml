@model IReadOnlyCollection<ProductVm>
@{
    ViewData["Title"] = "Quản lý Sản phẩm";
    var categories = (IReadOnlyCollection<CategoryVm>)(ViewBag.Categories ?? Array.Empty<CategoryVm>());
    var inventory = (IReadOnlyCollection<InventoryVm>)(ViewBag.Inventory ?? Array.Empty<InventoryVm>());
    var stockByProduct = inventory.ToDictionary(x => x.ProductId);
    var currentCategoryId = ViewBag.CategoryId as Guid?;
    var currentIsActive = ViewBag.IsActive as bool?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-dark mb-0">
        <i class="bi bi-box-seam text-primary me-2"></i>Quản lý Sản phẩm Cửa hàng
    </h2>
    <a asp-action="CreateProduct" class="btn btn-success fw-bold">
        <i class="bi bi-plus-lg me-1"></i>Tạo sản phẩm mới
    </a>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Tìm theo tên sản phẩm..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="categoryId" class="form-select">
                    <option value="">-- Tất cả Danh mục --</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.Id" selected="@(currentCategoryId == c.Id)">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="isActive" class="form-select">
                    <option value="">-- Tất cả Trạng thái --</option>
                    <option value="true" selected="@(currentIsActive == true)">Đang bán (Active)</option>
                    <option value="false" selected="@(currentIsActive == false)">Ngừng bán (Inactive)</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 fw-semibold">
                    <i class="bi bi-filter me-1"></i>Tìm & Lọc
                </button>
            </div>
        </form>
    </div>
</div>

@if (TempData["Success"] is string successMsg)
{
    <div class="alert alert-success shadow-sm mb-4"><i class="bi bi-check-circle me-1"></i>@successMsg</div>
}
@if (TempData["Error"] is string errorMsg)
{
    <div class="alert alert-danger shadow-sm mb-4"><i class="bi bi-exclamation-triangle me-1"></i>@errorMsg</div>
}
@if (ViewBag.Error is string err)
{
    <div class="alert alert-danger shadow-sm mb-4">@err</div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Giá bán</th>
                        <th>Tồn kho</th>
                        <th>Phân loại (Variants)</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Không tìm thấy sản phẩm nào.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
                                        {
                                            <img src="@p.ImageUrl" style="width: 45px; height: 45px; object-fit: cover;" class="rounded border" />
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded border d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                                                <i class="bi bi-image text-muted"></i>
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-bold text-dark">@p.Name</div>
                                            <small class="text-muted">Mã ID: <code>@p.Id.ToString()[..8]</code></small>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge bg-light text-dark border">@p.CategoryName</span></td>
                                <td class="fw-bold text-danger">@p.Price.ToString("N0") VNĐ</td>
                                <td>
                                    @if (stockByProduct.TryGetValue(p.Id, out var stock))
                                    {
                                        <div class="fw-bold">@stock.Quantity</div>
                                        <small class="text-muted">Bán được: @stock.AvailableQuantity · Đang giữ: @stock.ReservedQuantity</small>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Chưa thiết lập</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-info bg-opacity-10 text-info">@p.Variants.Count() phân loại</span>
                                </td>
                                <td>
                                    <span class="badge @(p.IsActive ? "bg-success" : "bg-secondary")">
                                        @(p.IsActive ? "Đang bán" : "Ngừng bán")
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="ProductDetails" asp-route-id="@p.Id" class="btn btn-outline-info" title="Xem chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="EditProduct" asp-route-id="@p.Id" class="btn btn-outline-warning" title="Chỉnh sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#stock-@p.Id" title="Cập nhật số lượng">
                                            <i class="bi bi-boxes"></i>
                                        </button>
                                        @if (p.IsActive)
                                        {
                                            <form asp-action="DeleteProduct" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@p.Id" />
                                                <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Bạn có chắc chắn muốn ngừng bán sản phẩm này?');" title="Ngừng bán">
                                                    <i class="bi bi-slash-circle"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                    <div class="modal fade text-start" id="stock-@p.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content border-0 shadow">
                                                <form asp-action="UpdateStock" method="post">
                                                    <div class="modal-header"><h5 class="modal-title fw-bold">Cập nhật số lượng</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                                                    <div class="modal-body">
                                                        <input type="hidden" name="productId" value="@p.Id"/>
                                                        <p>Sản phẩm: <strong>@p.Name</strong></p>
                                                        <label class="form-label fw-semibold">Tổng số lượng trong kho</label>
                                                        <input name="quantity" type="number" min="0" max="99999" step="1" value="@(stockByProduct.TryGetValue(p.Id, out var currentStock) ? currentStock.Quantity : 0)" class="form-control" required/>
                                                        <div class="form-text">Không thể đặt thấp hơn số lượng hàng đang được giữ.</div>
                                                        <label class="form-label fw-semibold mt-3">Lý do</label>
                                                        <input name="reason" class="form-control" placeholder="Ví dụ: nhập thêm hàng, kiểm kê..."/>
                                                    </div>
                                                    <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button><button class="btn btn-primary">Lưu số lượng</button></div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
