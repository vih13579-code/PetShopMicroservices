@model ProductFormVm
@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
    var categories = (IReadOnlyCollection<CategoryVm>)(ViewBag.Categories ?? Array.Empty<CategoryVm>());
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-dark mb-0">
        <i class="bi bi-pencil-square text-warning me-2"></i>Chỉnh sửa sản phẩm
    </h2>
    <a asp-action="Products" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form method="post" enctype="multipart/form-data" id="editProductForm">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Danh mục</label>
                    <select asp-for="CategoryId" class="form-select">
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label fw-semibold">Tên sản phẩm</label>
                    <input asp-for="Name" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label fw-semibold">Mô tả chi tiết</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>
                <div class="col-md-6">
                    <label asp-for="Price" class="form-label fw-semibold">Giá bán (VNĐ)</label>
                    <input asp-for="Price" class="form-control" type="number" step="1000" />
                </div>
                <div class="col-md-6">
                    <label asp-for="ImageFile" class="form-label fw-semibold">Thay hình ảnh</label>
                    <input asp-for="ImageFile" class="form-control" accept="image/png,image/jpeg,image/webp" />
                    <div class="form-text">Để trống nếu muốn giữ ảnh hiện tại.</div>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label class="form-check-label fw-semibold" asp-for="IsActive">Đang kinh doanh & Cho phép bán</label>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold text-dark mb-1"><i class="bi bi-tags text-primary me-2"></i>Chỉnh sửa Phân loại (Variants & SKU)</h5>
                    <p class="small text-muted mb-0">Quản lý và thêm nhiều phân loại cho sản phẩm.</p>
                </div>
                <button type="button" class="btn btn-outline-primary btn-sm fw-bold" id="addVariantBtn">
                    <i class="bi bi-plus-circle me-1"></i>Thêm phân loại
                </button>
            </div>

            <div id="variantsContainer">
                @if (Model.Variants != null && Model.Variants.Count > 0)
                {
                    for (int i = 0; i < Model.Variants.Count; i++)
                    {
                        <div class="variant-item row g-3 bg-light p-3 rounded mb-3 border align-items-center">
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Tên phân loại</label>
                                <input name="Variants[@i].Name" value="@Model.Variants[i].Name" class="form-control variant-name" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Mã SKU</label>
                                <input name="Variants[@i].Sku" value="@Model.Variants[i].Sku" class="form-control variant-sku" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Giá chênh lệch (+/- VNĐ)</label>
                                <input name="Variants[@i].AdditionalPrice" value="@Model.Variants[i].AdditionalPrice" class="form-control variant-price" type="number" />
                            </div>
                            <div class="col-md-1 text-end">
                                <button type="button" class="btn btn-outline-danger btn-sm remove-variant-btn" title="Xóa phân loại này">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="variant-item row g-3 bg-light p-3 rounded mb-3 border align-items-center">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Tên phân loại</label>
                            <input name="Variants[0].Name" class="form-control variant-name" value="Mặc định" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Mã SKU</label>
                            <input name="Variants[0].Sku" class="form-control variant-sku" placeholder="VD: SKU-001" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Giá chênh lệch (+/- VNĐ)</label>
                            <input name="Variants[0].AdditionalPrice" class="form-control variant-price" type="number" value="0" />
                        </div>
                        <div class="col-md-1 text-end">
                            <button type="button" class="btn btn-outline-danger btn-sm remove-variant-btn" title="Xóa phân loại này">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>

            <button type="submit" class="btn btn-warning fw-bold px-4 text-dark mt-3">
                <i class="bi bi-save me-1"></i>Lưu thay đổi
            </button>
            <a asp-action="Products" class="btn btn-outline-secondary mt-3 ms-2">Hủy</a>
        </form>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const container = document.getElementById("variantsContainer");
        const addBtn = document.getElementById("addVariantBtn");

        function reindexVariants() {
            const rows = container.querySelectorAll(".variant-item");
            rows.forEach((row, index) => {
                row.querySelector(".variant-name").name = `Variants[${index}].Name`;
                row.querySelector(".variant-sku").name = `Variants[${index}].Sku`;
                row.querySelector(".variant-price").name = `Variants[${index}].AdditionalPrice`;
            });
        }

        addBtn.addEventListener("click", function () {
            const count = container.querySelectorAll(".variant-item").length;
            const newRowHtml = `
                <div class="variant-item row g-3 bg-light p-3 rounded mb-3 border align-items-center">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Tên phân loại</label>
                        <input name="Variants[${count}].Name" class="form-control variant-name" placeholder="Ví dụ: Gói 3kg / Size L" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Mã SKU (Tùy chọn)</label>
                        <input name="Variants[${count}].Sku" class="form-control variant-sku" placeholder="VD: SKU-0${count + 1}" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Giá chênh lệch (+/- VNĐ)</label>
                        <input name="Variants[${count}].AdditionalPrice" class="form-control variant-price" type="number" value="0" />
                    </div>
                    <div class="col-md-1 text-end">
                        <button type="button" class="btn btn-outline-danger btn-sm remove-variant-btn" title="Xóa phân loại này">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>`;
            container.insertAdjacentHTML("beforeend", newRowHtml);
            reindexVariants();
        });

        container.addEventListener("click", function (e) {
            const removeBtn = e.target.closest(".remove-variant-btn");
            if (removeBtn) {
                const row = removeBtn.closest(".variant-item");
                if (container.querySelectorAll(".variant-item").length > 1) {
                    row.remove();
                    reindexVariants();
                } else {
                    alert("Sản phẩm phải có ít nhất 1 phân loại.");
                }
            }
        });
    });
</script>
}
