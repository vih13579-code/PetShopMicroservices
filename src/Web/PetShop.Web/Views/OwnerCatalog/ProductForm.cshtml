@model ProductFormVm
@{ ViewData["Title"] = Model.Id == Guid.Empty ? "Tạo sản phẩm" : "Cập nhật sản phẩm"; var categories=(IReadOnlyCollection<CategoryVm>)(ViewBag.Categories??Array.Empty<CategoryVm>()); var canSave = ViewBag.CanSave is true; }
<div class="page-head"><div><span class="eyebrow">Catalog Studio</span><h1>@ViewData["Title"]</h1><p>Thông tin rõ ràng giúp sản phẩm dễ được tìm thấy hơn.</p></div><a class="btn btn-light" asp-action="Products"><i data-lucide="arrow-left"></i>Quay lại</a></div>
@if (ViewBag.CategoriesError is string categoryError) { <div class="alert alert-danger"><i data-lucide="circle-alert"></i><div><strong>Không tải được danh mục.</strong><div>@categoryError</div></div></div> }
else if (!categories.Any()) { <div class="alert alert-warning"><i data-lucide="folder-plus"></i><div><strong>Shop chưa có danh mục.</strong><div>Hãy <a asp-action="Categories" class="alert-link">tạo ít nhất một danh mục</a> trước khi thêm sản phẩm.</div></div></div> }
<form method="post" id="productForm" novalidate><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="row g-4"><div class="col-lg-7"><section class="surface panel mb-4"><h2 class="h5 mb-3">Thông tin cơ bản</h2><div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" required minlength="2" maxlength="220"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="6" maxlength="3000"></textarea><span asp-validation-for="Description" class="text-danger"></span></div><div><label asp-for="ImageUrl" class="form-label"></label><input asp-for="ImageUrl" class="form-control" type="url" maxlength="1000" placeholder="https://..."/><span asp-validation-for="ImageUrl" class="text-danger"></span></div></section>
<section class="surface overflow-hidden"><div class="panel d-flex justify-content-between align-items-center"><div><h2 class="h5 mb-1">Phân loại sản phẩm</h2><p class="small text-secondary mb-0">Ví dụ: kích thước, màu sắc hoặc quy cách.</p></div><button type="button" id="addVariant" class="btn btn-outline-primary"><i data-lucide="plus"></i>Thêm</button></div><div id="variants">@for(var i=0;i<Model.Variants.Count;i++){<div class="variant-row"><input asp-for="Variants[i].Id" type="hidden"/><div><label class="form-label">Tên phân loại</label><input asp-for="Variants[i].Name" class="form-control" required maxlength="150"/></div><div><label class="form-label">SKU</label><input asp-for="Variants[i].Sku" class="form-control sku-input" required maxlength="80"/></div><div><label class="form-label">Giá cộng thêm</label><input id="Variants_@(i)__AdditionalPrice" name="Variants[@i].AdditionalPrice" value="@Model.Variants[i].AdditionalPrice.ToString("0", System.Globalization.CultureInfo.InvariantCulture)" class="form-control" type="number" min="0" max="1000000000" step="1" oninvalid="this.setCustomValidity('Giá cộng thêm phải là số nguyên không âm.')" oninput="this.setCustomValidity('')"/></div><div class="form-check form-switch mb-2"><input asp-for="Variants[i].IsActive" class="form-check-input"/><label class="small">Bán</label></div><button type="button" class="btn btn-light icon-btn text-danger remove-variant mb-1" title="Xóa"><i data-lucide="trash-2"></i></button></div>}</div><div id="variantError" class="text-danger px-3 pb-3"></div></section></div>
<div class="col-lg-5"><section class="surface panel position-sticky" style="top:92px"><h2 class="h5 mb-3">Danh mục & giá</h2><div class="mb-3"><label asp-for="CategoryId" class="form-label"></label><select asp-for="CategoryId" class="form-select" required disabled="@(!canSave)"><option value="">Chọn danh mục</option>@foreach(var c in categories.Where(x=>x.IsActive || x.Id==Model.CategoryId)){<option value="@c.Id">@c.Name</option>}</select><span asp-validation-for="CategoryId" class="text-danger"></span></div><div class="mb-3"><label asp-for="Price" class="form-label"></label><div class="input-group"><input id="Price" name="Price" value="@Model.Price.ToString("0", System.Globalization.CultureInfo.InvariantCulture)" class="form-control" type="number" min="1" max="1000000000" step="1" required oninvalid="this.setCustomValidity('Giá bán phải là số nguyên từ 1 đến 1.000.000.000 đồng.')" oninput="this.setCustomValidity('')"/><span class="input-group-text">đ</span></div><span asp-validation-for="Price" class="text-danger"></span></div><div class="form-check form-switch mb-4"><input asp-for="IsActive" class="form-check-input"/><label asp-for="IsActive" class="form-check-label">Đang bán</label></div><button class="btn btn-primary w-100" disabled="@(!canSave)"><i data-lucide="save"></i>Lưu sản phẩm</button></section></div></div></form>
<template id="variantTemplate"><div class="variant-row"><input name="Variants[__index__].Id" type="hidden"/><div><label class="form-label">Tên phân loại</label><input name="Variants[__index__].Name" class="form-control" required maxlength="150"/></div><div><label class="form-label">SKU</label><input name="Variants[__index__].Sku" class="form-control sku-input" required maxlength="80"/></div><div><label class="form-label">Giá cộng thêm</label><input name="Variants[__index__].AdditionalPrice" class="form-control" type="number" value="0" min="0" max="1000000000" step="1" oninvalid="this.setCustomValidity('Giá cộng thêm phải là số nguyên không âm.')" oninput="this.setCustomValidity('')"/></div><div class="form-check form-switch mb-2"><input name="Variants[__index__].IsActive" type="checkbox" value="true" checked class="form-check-input"/><input name="Variants[__index__].IsActive" type="hidden" value="false"/><label class="small">Bán</label></div><button type="button" class="btn btn-light icon-btn text-danger remove-variant mb-1"><i data-lucide="trash-2"></i></button></div></template>
@section Scripts { <partial name="_ValidationScriptsPartial"/><script src="~/js/catalog-form.js" asp-append-version="true"></script> }
