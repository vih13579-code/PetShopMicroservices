@model ProductVm
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    var reviews = (IReadOnlyCollection<ReviewVm>)(ViewBag.Reviews ?? Array.Empty<ReviewVm>());
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-dark mb-0">
        <i class="bi bi-box-seam text-info me-2"></i>Chi tiết sản phẩm Cửa hàng
    </h2>
    <a asp-action="Products" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
    </a>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-5">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body p-4 text-center">
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="img-fluid rounded mb-3" style="max-height: 300px; object-fit: cover;" />
                }
                else
                {
                    <div class="bg-light p-5 rounded mb-3 text-muted">
                        <i class="bi bi-image fs-1"></i>
                        <p class="mb-0">Chưa có hình ảnh</p>
                    </div>
                }
                <h4 class="fw-bold text-dark mb-1">@Model.Name</h4>
                <p class="badge bg-light text-dark border fs-6">Danh mục: @Model.CategoryName</p>
                <h3 class="fw-bold text-danger mt-2">@Model.Price.ToString("N0") VNĐ</h3>
                <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary") fs-6 mt-1">
                    @(Model.IsActive ? "Đang kinh doanh" : "Tạm ngừng bán")
                </span>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-tags me-2 text-primary"></i>Danh sách Phân loại (Variants & SKU)</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Tên phân loại</th>
                                <th>Mã SKU</th>
                                <th>Giá chênh lệch</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Variants == null || !Model.Variants.Any())
                            {
                                <tr><td colspan="4" class="text-center py-3 text-muted">Chưa có phân loại.</td></tr>
                            }
                            else
                            {
                                @foreach (var v in Model.Variants)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold text-dark">@v.Name</td>
                                        <td><code>@v.Sku</code></td>
                                        <td>+@v.AdditionalPrice.ToString("N0") VNĐ</td>
                                        <td>
                                            <span class="badge @(v.IsActive ? "bg-success" : "bg-secondary")">
                                                @(v.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-card-text me-2 text-secondary"></i>Mô tả chi tiết</h5>
            </div>
            <div class="card-body pt-0">
                <p class="text-muted mb-0">@(string.IsNullOrWhiteSpace(Model.Description) ? "Chưa có mô tả chi tiết cho sản phẩm này." : Model.Description)</p>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 border-0">
        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-star-fill me-2 text-warning"></i>Đánh giá từ khách hàng (@reviews.Count)</h5>
    </div>
    <div class="card-body">
        @if (reviews == null || !reviews.Any())
        {
            <div class="text-center py-4 text-muted">Chưa có đánh giá nào cho sản phẩm này.</div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var r in reviews)
                {
                    <div class="col-md-6">
                        <div class="border p-3 rounded bg-light">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="text-warning">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="bi @(i <= r.Rating ? "bi-star-fill" : "bi-star")"></i>
                                    }
                                </div>
                                <small class="text-muted">@r.CreatedAt.ToString("dd/MM/yyyy")</small>
                            </div>
                            <p class="mb-0 text-dark">@(string.IsNullOrWhiteSpace(r.Comment) ? "Không có nhận xét." : r.Comment)</p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
