@model ProductVm
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    var reviews = (IReadOnlyCollection<ReviewVm>)(ViewBag.Reviews ?? Array.Empty<ReviewVm>());
}

<div class="page-head">
    <div>
        <span class="eyebrow">Catalog Studio</span>
        <h1>@Model.Name</h1>
        <p>Thông tin sản phẩm đang hiển thị trong Shop.</p>
    </div>
    <div class="action-row">
        <a class="btn btn-light" asp-action="Products"><i data-lucide="arrow-left"></i>Quay lại</a>
        <a class="btn btn-primary" asp-action="ProductForm" asp-route-id="@Model.Id"><i data-lucide="pencil"></i>Chỉnh sửa</a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-5">
        <section class="surface overflow-hidden h-100">
            <div class="product-media" style="aspect-ratio: 4 / 3;">
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="w-100 h-100 object-fit-cover" />
                }
                else
                {
                    <div class="empty h-100"><i data-lucide="image"></i><div>Chưa có hình ảnh</div></div>
                }
            </div>
            <div class="panel">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div><div class="product-meta">@Model.CategoryName</div><div class="price fs-3">@Model.Price.ToString("N0") đ</div></div>
                    <span class="status @(Model.IsActive ? "status-on" : "status-off")">@(Model.IsActive ? "Đang bán" : "Ngừng bán")</span>
                </div>
                <p class="text-secondary mt-3 mb-0">@(string.IsNullOrWhiteSpace(Model.Description) ? "Sản phẩm chưa có mô tả." : Model.Description)</p>
            </div>
        </section>
    </div>
    <div class="col-lg-7">
        <section class="surface overflow-hidden h-100">
            <div class="panel"><h2 class="h5 mb-1">Phân loại & SKU</h2><p class="small text-secondary mb-0">@Model.Variants.Count phân loại của sản phẩm.</p></div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead><tr><th>Phân loại</th><th>SKU</th><th>Giá cộng thêm</th><th>Trạng thái</th></tr></thead>
                    <tbody>
                    @foreach (var variant in Model.Variants)
                    {
                        <tr><td><strong>@variant.Name</strong></td><td><code>@variant.Sku</code></td><td>@variant.AdditionalPrice.ToString("N0") đ</td><td><span class="status @(variant.IsActive ? "status-on" : "status-off")">@(variant.IsActive ? "Đang bán" : "Ngừng bán")</span></td></tr>
                    }
                    @if (!Model.Variants.Any())
                    {
                        <tr><td colspan="4"><div class="empty"><i data-lucide="tags"></i><div>Sản phẩm chưa có phân loại.</div></div></td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>

<section class="surface overflow-hidden">
    <div class="panel"><h2 class="h5 mb-1">Đánh giá khách hàng</h2><p class="small text-secondary mb-0">@reviews.Count đánh giá đã gửi cho sản phẩm.</p></div>
    @if (ViewBag.ReviewsError is string reviewsError)
    {
        <div class="alert alert-warning mx-3">@reviewsError</div>
    }
    else if (!reviews.Any())
    {
        <div class="empty"><i data-lucide="message-square"></i><div>Chưa có đánh giá nào.</div></div>
    }
    else
    {
        <div class="row g-3 p-3 pt-0">
        @foreach (var review in reviews)
        {
            <div class="col-md-6"><article class="border p-3 rounded"><div class="d-flex justify-content-between gap-3"><strong>@review.Rating/5 sao</strong><span class="small text-secondary">@review.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span></div><p class="mb-0 mt-2">@(string.IsNullOrWhiteSpace(review.Comment) ? "Không có nhận xét." : review.Comment)</p></article></div>
        }
        </div>
    }
</section>
