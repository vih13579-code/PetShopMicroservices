@model ProfileFormVm
@{
    ViewData["Title"] = "Cập nhật tài khoản";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-dark mb-0">
        <i class="bi bi-pencil-square text-warning me-2"></i>Cập nhật tài khoản
    </h2>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Quay lại
    </a>
</div>

<div class="card shadow-sm border-0" style="max-width: 700px;">
    <div class="card-body p-4">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Email tài khoản</label>
                <input value="@Model.Email" class="form-control bg-light" disabled />
            </div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label fw-semibold">Họ và tên</label>
                <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên..." />
            </div>

            <div class="mb-3">
                <label asp-for="Phone" class="form-label fw-semibold">Số điện thoại</label>
                <input asp-for="Phone" class="form-control" placeholder="Nhập số điện thoại..." />
            </div>

            <div class="mb-4">
                <label asp-for="Address" class="form-label fw-semibold">Địa chỉ</label>
                <textarea asp-for="Address" class="form-control" rows="3" placeholder="Nhập địa chỉ..."></textarea>
            </div>

            <button type="submit" class="btn btn-warning fw-bold px-4 text-dark">
                <i class="bi bi-check-lg me-1"></i>Lưu thông tin
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
        </form>
    </div>
</div>
