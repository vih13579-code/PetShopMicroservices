@model UserVm
@{
    ViewData["Title"] = "Chi tiết tài khoản";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-dark mb-0">
        <i class="bi bi-person-lines-fill text-info me-2"></i>Chi tiết tài khoản
    </h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
    </a>
</div>

@if (TempData["Success"] is string msg)
{
    <div class="alert alert-success shadow-sm mb-4">
        <i class="bi bi-check-circle me-1"></i>@msg
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <div class="row g-4">
            <div class="col-md-4 text-center border-end">
                <div class="bg-info bg-opacity-10 text-info rounded-circle d-inline-flex p-4 mb-3">
                    <i class="bi bi-person-fill fs-1"></i>
                </div>
                <h4 class="fw-bold mb-1">@Model.FullName</h4>
                <p class="text-muted small mb-2">@Model.Email</p>
                <div>
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger") fs-6 mb-3">
                        @(Model.IsActive ? "Active" : "Locked")
                    </span>
                </div>
                <div class="d-flex flex-wrap justify-content-center gap-1">
                    @foreach (var r in Model.Roles)
                    {
                        <span class="badge bg-secondary">@r</span>
                    }
                </div>
            </div>
            <div class="col-md-8">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-info-circle me-2 text-primary"></i>Thông tin chi tiết</h5>
                <dl class="row mb-4">
                    <dt class="col-sm-3 text-muted">ID tài khoản:</dt>
                    <dd class="col-sm-9"><code class="text-dark">@Model.Id</code></dd>

                    <dt class="col-sm-3 text-muted">Họ và tên:</dt>
                    <dd class="col-sm-9 fw-semibold">@Model.FullName</dd>

                    <dt class="col-sm-3 text-muted">Email:</dt>
                    <dd class="col-sm-9">@Model.Email</dd>

                    <dt class="col-sm-3 text-muted">Số điện thoại:</dt>
                    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Phone) ? "Chưa cập nhật" : Model.Phone)</dd>

                    <dt class="col-sm-3 text-muted">Địa chỉ:</dt>
                    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Address) ? "Chưa cập nhật" : Model.Address)</dd>

                    <dt class="col-sm-3 text-muted">Ngày tạo:</dt>
                    <dd class="col-sm-9">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</dd>
                </dl>

                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning fw-semibold text-dark">
                        <i class="bi bi-pencil me-1"></i>Chỉnh sửa tài khoản
                    </a>
                    <form method="post" asp-action="@(Model.IsActive ? "Lock" : "Unlock")" class="d-inline">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn @(Model.IsActive ? "btn-danger" : "btn-success") fw-semibold">
                            <i class="bi @(Model.IsActive ? "bi-lock" : "bi-unlock") me-1"></i>
                            @(Model.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
